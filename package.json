{
    "name": "toml-edit-js",
    "type": "module",
    "version": "0.2.1",
    "private": true,
    "packageManager": "pnpm@10.11.0",
    "scripts": {
        "build": "wasmup build .",
        "bump": "cross-release -ayx 'pnpm changelog'",
        "changelog": "conventional-changelog -si CHANGELOG.md",
        "lint": "eslint .",
        "prepare": "husky",
        "release": "pnpm bump && pnpm build && pnpm -r publish",
        "test": "vitest",
        "test:wasm": "wasm-pack test --headless --chrome",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^19.8.1",
        "@rainbowatcher/eslint-config": "^0.21.1",
        "@rainbowatcher/eslint-config-ignore": "^0.21.1",
        "@rainbowatcher/eslint-config-js": "^0.21.1",
        "@rainbowatcher/eslint-config-json": "^0.21.1",
        "@rainbowatcher/eslint-config-md": "^0.21.1",
        "@rainbowatcher/eslint-config-prettier": "^0.21.1",
        "@rainbowatcher/eslint-config-toml": "^0.21.1",
        "@rainbowatcher/eslint-config-ts": "^0.21.1",
        "@types/node": "^22.15.18",
        "commitlint": "^19.8.1",
        "conventional-changelog-cli": "^5.0.0",
        "cross-release-cli": "^0.3.0",
        "dedent": "^1.6.0",
        "eslint": "^9.26.0",
        "husky": "^9.1.7",
        "toml-edit-js": "workspace:*",
        "typescript": "^5.8.3",
        "vitest": "^3.1.3",
        "wasmup": "^0.9.0"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    }
}
