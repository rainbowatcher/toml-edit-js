{
    "name": "toml-edit-js",
    "type": "module",
    "version": "0.6.3",
    "private": true,
    "packageManager": "pnpm@10.22.0",
    "scripts": {
        "build": "wasmup build .",
        "build:debug": "wasmup build --dev . && pnpm debug:cp",
        "debug:cp": "cp tests/fixture/debug.html packages/toml-edit-js/",
        "bump": "cross-release -ayx 'pnpm changelog'",
        "changelog": "conventional-changelog -si CHANGELOG.md",
        "lint": "eslint .",
        "prepare": "husky",
        "release": "pnpm bump && pnpm build && pnpm -r publish",
        "test": "vitest",
        "test:wasm": "wasm-pack test --chrome",
        "bench": "vitest bench",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^20.0.0",
        "@rainbowatcher/eslint-config": "^0.21.1",
        "@rainbowatcher/eslint-config-ignore": "^0.21.1",
        "@rainbowatcher/eslint-config-js": "^0.21.1",
        "@rainbowatcher/eslint-config-json": "^0.21.1",
        "@rainbowatcher/eslint-config-md": "^0.21.1",
        "@rainbowatcher/eslint-config-prettier": "^0.21.1",
        "@rainbowatcher/eslint-config-toml": "^0.21.1",
        "@rainbowatcher/eslint-config-ts": "^0.21.1",
        "@types/node": "^24.10.1",
        "commitlint": "^20.1.0",
        "conventional-changelog-cli": "^5.0.0",
        "cross-release-cli": "^0.4.0",
        "dedent": "^1.7.0",
        "eslint": "^9.39.1",
        "husky": "^9.1.7",
        "typescript": "^5.9.3",
        "vitest": "^4.0.10",
        "wasmup": "^0.10.1"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ],
        "rules": {
          "body-max-line-length": [0, "never"]
        }
    }
}
