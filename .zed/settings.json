{
    "formatter": {
        "code_actions": {
            // Use ESLint's --fix:
            "source.fixAll.eslint": true,
            // Organize imports on save:
            "source.organizeImports": true
        }
    },
    "languages": {
        "TypeScript": {
            "code_actions_on_format": {
                "source.fixAll.eslint": true
            }
        },
        "Json": {
            "code_actions_on_format": {
                "source.fixAll.eslint": true
            }
        }
    }
}
