{
  "compilerOptions": {
    "target": "ESNext",
    "paths": { "*": ["./*"] },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["tests/*.ts", "bench/*.ts", "packages/**/*.ts", "scripts/*.ts", "wasmup.config.ts"]
}
